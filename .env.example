# Copy to .env and fill in. Only the providers you configure are used;
# every channel defaults to "console" (dev mode: messages are recorded, not sent).

# --- Core ---
# DEV_MODE=true enables the /v1/dev/otp-code helper and a default dev API key.
# NEVER run production with DEV_MODE=true.
DEV_MODE=true
DATABASE_PATH=./data/messaging.db
# Comma-separated API keys clients must send as X-API-Key.
# Leave empty in DEV_MODE to use the dev key "dev-key-change-me".
MESSAGING_API_KEYS=

# --- OTP ---
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
# Secret pepper for hashing OTP codes. Set a long random value in production.
OTP_PEPPER=

# --- Provider selection per channel: console | twilio | meta | rcs ---
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
RCS_PROVIDER=console

# --- Twilio (SMS + WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# --- Meta WhatsApp Cloud API (WhatsApp, incl. templates) ---
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v21.0
META_VERIFY_TOKEN=

# --- Generic RCS / RBM HTTP adapter ---
# Real RCS delivery needs a registered Google RCS Business Messaging (RBM)
# agent. Point this at your RBM partner's endpoint; see README.
RCS_PROVIDER_URL=
RCS_PROVIDER_TOKEN=
